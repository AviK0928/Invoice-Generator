<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.example.invoice</groupId>
    <artifactId>invoice-generator</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>invoice-generator</name>
    <description>Invoice Generator - multi-module reactor build</description>

    <!--
      Aggregator AND parent. Every module inherits from here, and this POM
      inherits from spring-boot-starter-parent, so the Boot BOM, the Java
      level and the -parameters compiler flag reach all seven modules from
      one place instead of being repeated in each.

      Note what does NOT follow from that: inheriting the Boot parent does not
      make a module a Boot application. Only declaring spring-boot-maven-plugin
      with the repackage goal does. `common` inherits from here and still
      produces a plain library jar.
    -->
    <modules>
        <module>common</module>
        <module>api-gateway</module>
        <module>customer-service</module>
        <module>invoice-service</module>
        <module>export-service</module>
        <module>import-service</module>
        <module>archive-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Explicit, not merely implied by java.version, which on its own
             sets nothing. `common` compiled to Java 8 for a while because of
             exactly that. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.8.13</springdoc.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <build>
        <plugins>
            <!--
              Inherited by every module, so integration tests run everywhere
              without each POM declaring this.

              In <plugins>, not <pluginManagement>: pluginManagement configures
              a plugin a module already declares, it does not add one. This
              block spent one run in pluginManagement with the module
              declarations already deleted — nine integration tests silently
              stopped running and the build still reported SUCCESS. Modules
              with no *IT classes print "No tests to run" and cost nothing.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Coverage, in <plugins> for the same reason as Failsafe: the
              agent goals have to actually run in every module.

              Two prepare executions because Surefire and Failsafe fork
              separate JVMs and write separate .exec files. Wiring only the
              unit one would drop every integration test from the number, and
              those cover the services, the importer and the outbox.

              Both prepare goals write a property that Surefire and Failsafe
              read as their argLine. Nothing here references those properties
              explicitly yet — see the note in the local-docker profile.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-unit</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>prepare-integration</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-unit</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-integration</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <!--
                  Config only, and the asymmetry with Failsafe above is
                  deliberate. In <plugins> this would repackage every module
                  including `common`, whose consumers need a plain library jar.
                  Services opt in by declaring the plugin themselves; the
                  Lombok exclusion reaches them from here.
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
          Testcontainers 1.21 negotiates Docker API 1.32, which the Codespace's
          docker-in-docker daemon rejects (minimum 1.40). Activated only when CI
          is unset, so it never applies on a GitHub Actions runner where the
          daemon is plain and these settings are at best redundant.

          This <argLine> replaces rather than appends, so it currently drops
          JaCoCo's integration agent — integration coverage will read low in the
          Codespace and correctly in CI. Left as-is deliberately: four attempts
          at @{...} late evaluation all ended with the placeholder reaching the
          JVM literally ("could not open `{surefireArgLine}'"), so that is being
          settled separately rather than while the build is red.
        -->
        <profile>
            <id>local-docker</id>
            <activation>
                <property>
                    <name>!env.CI</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <argLine>-Dapi.version=1.43 -Ddocker.host=unix:///var/run/docker.sock</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>