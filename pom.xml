<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.example.invoice</groupId>
    <artifactId>invoice-generator</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>invoice-generator</name>
    <description>Invoice Generator - multi-module reactor build</description>

    <modules>
        <module>common</module>
        <module>api-gateway</module>
        <module>customer-service</module>
        <module>invoice-service</module>
        <module>export-service</module>
        <module>import-service</module>
        <module>archive-service</module>
        <module>coverage</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Explicit, not merely implied by java.version, which on its own
             sets nothing. `common` compiled to Java 8 for a while because of
             exactly that. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.8.13</springdoc.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!--
          Empty defaults so the @{...} references below resolve to nothing when
          JaCoCo has not run — skipped, or a lifecycle that misses initialize.
          Recommended by the prepare-agent docs, and the explanation for four
          earlier attempts dying with "could not open `{surefireArgLine}'":
          the placeholder only survives as literal text when the plugin that
          was supposed to set the property never executed.
        -->
        <surefireArgLine/>
        <failsafeArgLine/>
        <!-- Floor per module, not a target. Raise as coverage climbs. -->
        <coverage.minimum>0.55</coverage.minimum>
    </properties>

    <build>
        <plugins>
            <!--
              Failsafe and JaCoCo are both here rather than in
              pluginManagement, and for the same reason: management configures
              a plugin a module already declares, it does not add one. Failsafe
              spent one run managed-only with the module declarations already
              deleted — nine integration tests silently stopped running and the
              build still reported SUCCESS. JaCoCo spent four runs the same
              way, which is why its property never existed and every @{...}
              reached the JVM verbatim.

              Modules with no *IT classes print "No tests to run" and cost
              nothing.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{failsafeArgLine}</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Surefire needs the reference spelled out because the two JaCoCo
              prepare goals both default to writing a property called
              "argLine", so the integration one would overwrite the unit one
              and Surefire would instrument into the wrong .exec file. Distinct
              property names are what allow two agents in one module; the cost
              is that neither is picked up implicitly any more.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{surefireArgLine}</argLine>
                </configuration>
            </plugin>

            <!--
              Coverage. Two prepare executions because Surefire and Failsafe
              fork separate JVMs and write separate .exec files; wiring only
              the unit one would drop every integration test from the number,
              and those are the tests covering the services, the importer and
              the outbox.

              No <phase> on the prepare executions: the docs give initialize
              for prepare-agent and pre-integration-test for
              prepare-agent-integration, which is what is wanted.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-unit</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <propertyName>surefireArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>prepare-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <propertyName>failsafeArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report-unit</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report-integration</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>report-integration</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <!--
                  Config only, and the asymmetry with the three above is
                  deliberate. In <plugins> this would repackage every module
                  including `common`, whose consumers need a plain library jar.
                  Services opt in by declaring the plugin themselves; the
                  Lombok exclusion reaches them from here.
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <!--
                        The classifier is what makes `app` possible. Without it repackage
                        REPLACES the main artifact, so a module depending on a service gets
                        a fat jar with nested BOOT-INF on its classpath. With it, each
                        service produces two artifacts: x.jar, a plain library jar that
                        `app` and `coverage` can depend on, and x-exec.jar, the runnable
                        one. `common` is unaffected — it never declares this plugin.

                        Anything that consumed target/*.jar must now name -exec.jar
                        explicitly: two jars match the glob.
                        -->
                        <classifier>exec</classifier>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>merge-exec</id>
                            <!-- merge binds to generate-resources by default,
                                 which is long before any .exec file exists.
                                 post-integration-test is after both agents
                                 have written. -->
                            <phase>post-integration-test</phase>
                            <goals>
                                <goal>merge</goal>
                            </goals>
                            <configuration>
                                <fileSets>
                                    <fileSet>
                                        <directory>${project.build.directory}</directory>
                                        <includes>
                                            <include>jacoco.exec</include>
                                            <include>jacoco-it.exec</include>
                                        </includes>
                                    </fileSet>
                                </fileSets>
                                <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
                            </configuration>
                        </execution>
                        <execution>
                            <id>check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>INSTRUCTION</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${coverage.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
          Testcontainers 1.21 negotiates Docker API 1.32, which the Codespace's
          docker-in-docker daemon rejects (minimum 1.40). Activated only when CI
          is unset, so it never applies on a GitHub Actions runner where the
          daemon is plain and these settings are at best redundant.

          The @{failsafeArgLine} prefix is load-bearing. This <argLine>
          replaces the one in the main build rather than merging with it, so
          without the prefix Failsafe forks uninstrumented, jacoco-it.exec is
          never written, and integration coverage reads zero in the Codespace
          while reading correctly in CI.
        -->
        <profile>
            <id>local-docker</id>
            <activation>
                <property>
                    <name>!env.CI</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <argLine>@{failsafeArgLine} -Dapi.version=1.43 -Ddocker.host=unix:///var/run/docker.sock</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>