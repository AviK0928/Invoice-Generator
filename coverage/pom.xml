<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.invoice</groupId>
        <artifactId>invoice-generator</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>coverage</artifactId>
    <packaging>pom</packaging>

    <!--
      No sources. This module exists only to produce one coverage figure for
      the whole reactor.

      report-aggregate builds its report from the modules this project depends
      on, so the dependency list below IS the scope of the number — a module
      missing from it is silently missing from the coverage figure. It must
      also build last, which the dependency list guarantees.

      Both jacoco.exec and jacoco-it.exec are picked up: the docs say all
      *.exec files in each project's target folder are included when
      dataFileIncludes is not specified. That matters here — an aggregate
      counting unit data alone would report invoice-service at 8% rather than
      the 56% its integration tests reach.
    -->
    <dependencies>
        <dependency>
            <groupId>com.example.invoice</groupId>
            <artifactId>common</artifactId>
            <version>1.5.0</version>
        </dependency>
        <dependency>
            <groupId>com.example.invoice</groupId>
            <artifactId>api-gateway</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.invoice</groupId>
            <artifactId>customer-service</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.invoice</groupId>
            <artifactId>invoice-service</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.invoice</groupId>
            <artifactId>export-service</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.invoice</groupId>
            <artifactId>import-service</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.example.invoice</groupId>
            <artifactId>archive-service</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>Invoice Generator</title>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!--
                              30% against a measured 34%. A floor, not a
                              target: it exists to catch a drop, and should be
                              raised as api-gateway, export-service and
                              archive-service get tests. Picking a number
                              before measuring would have been guesswork —
                              the unit-only figure was 8%.
                            -->
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.30</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>