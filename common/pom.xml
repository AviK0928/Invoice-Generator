<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.invoice</groupId>
        <artifactId>invoice-generator</artifactId>
        <version>1.0.0</version>
    </parent>

    <groupId>com.example.invoice</groupId>
    <artifactId>common</artifactId>
    <version>1.5.0</version>

    <name>common</name>
    <description>Common Module for Invoice Generator</description>

    <!--
      A library, not a Spring Boot application — because it declares no
      spring-boot-maven-plugin, so nothing repackages it. That, not the
      parent, is what makes a module an application.

      This module had no parent at all until the root POM was promoted, on the
      belief that inheriting one would make it an application. It doesn't, and
      the belief cost two bugs:

      1. java.version alone sets nothing. Without maven.compiler.release this
         module compiled to Java 8 while every other module compiled to 21.

      2. Without spring-boot-starter-parent's -parameters flag, argument names
         were stripped from the bytecode and Spring Data could not bind named
         query parameters.

      Both now come from the parent. @Param stays on every repository method
      regardless: that failure is at runtime and reads as a query bug, so the
      belt-and-braces is worth keeping.

      Its own version too — 1.5.0, not the parent's 1.0.0. Services depend on
      it by explicit version.
    -->

    <properties>
        <!--
          Measured but not gated. common's own report sees only its two unit
          test classes, so it reads 11% — but the outbox, inbox and
          BaseExceptionHandler are covered by the integration tests of the four
          services that use them, which write to their exec files, not this one.
          The aggregate report counts that; a per-module check cannot see it.

          haltOnFailure rather than jacoco.skip: skip would disable the agent
          too, and this module's unit coverage would vanish from the aggregate
          as well as from the gate. The check still runs and still reports the
          violation — it just does not fail the build.
        -->
        <jacoco.haltOnFailure>false</jacoco.haltOnFailure>
        <commons-csv.version>1.10.0</commons-csv.version>
    </properties>

    <dependencies>

        <!-- ==================== compile scope ==================== -->

        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>

        <!-- optional, not provided: provided removes it from the compile
             classpath where Maven discovers annotation processors, so Lombok
             silently stops generating and every getter reports as missing. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== provided scope ====================
             Needed to compile the shared web and persistence infrastructure
             (BaseExceptionHandler, outbox, inbox). Provided so this stays a
             library: a consumer that does not serve HTTP or use JPA is not
             forced to pull in the stack, and every service already has it. -->

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- NoResourceFoundException, for the unmapped-path handler. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- MissingServletRequestParameterException extends ServletException. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ==================== test scope ====================
             CsvUtil and HashUtil are pure and used by three services between
             them, so they are unit tested here rather than incidentally
             through someone else's integration tests. Everything else in this
             module needs a Spring context and is covered where it is used. -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JwtEncoder and the claims builder. Brings spring-security-core and
             spring-security-crypto transitively, which is where
             BadCredentialsException and BCryptPasswordEncoder come from.
             provided, like everything else here: the consumer supplies the
             runtime. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- @Tag and @Operation on AuthController. The starter-common artifact
             rather than swagger-annotations directly, so the version comes from
             the same property as the two UI starters. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-common</artifactId>
            <version>${springdoc.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>